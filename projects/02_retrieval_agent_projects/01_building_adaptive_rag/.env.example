# Building Adaptive RAG - copy to .env (never commit .env). Names only; fill in the values you use.
# src/models/model.py - Gemini chat model and embeddings
GOOGLE_API_KEY=
# src/workflow/nodes/web_search.py - Tavily web search fallback
TAVILY_API_KEY=
# optional - LangSmith tracing
LANGCHAIN_API_KEY=
# optional - set to true to trace (needs LANGCHAIN_API_KEY)
LANGCHAIN_TRACING_V2=
# optional - LangSmith endpoint
LANGCHAIN_ENDPOINT=
# optional - LangSmith project name
LANGCHAIN_PROJECT=
