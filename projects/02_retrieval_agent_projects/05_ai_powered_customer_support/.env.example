# AI-Powered Customer Support Copilot - copy to .env (never commit .env). Names only; fill in the values you use.
# core/settings.py - reply drafting (copilot_service.py); notebooks/experiments.ipynb - Mem0 LLM and agent
GROQ_API_KEY=
# core/settings.py - Gemini embeddings for Chroma RAG and Mem0; notebooks/experiments.ipynb - Mem0 embedder
GOOGLE_API_KEY=
# core/settings.py - optional
OPENAI_API_KEY=
# optional - default llama-3.1-8b-instant
GROQ_MODEL=
# app.py - where the Streamlit dashboard finds the API (default http://localhost:8000)
API_BASE_URL=
