# Deep Agents App — Memory Command Center - copy to .env (never commit .env). Names only; fill in the values you use.
# backend/src/deep_agent/config.py - workspace URL
DATABRICKS_HOST=
# backend/src/deep_agent/config.py - workspace token
DATABRICKS_TOKEN=
# tools/search.py - web search
TAVILY_API_KEY=
# stores/lakebase.py - Lakebase instance (default deep-agent-memory)
LAKEBASE_INSTANCE_NAME=
# stores/lakebase.py - database (default databricks_postgres)
LAKEBASE_DATABASE=
# optional - serving endpoint (default databricks-claude-sonnet-4-6)
MODEL_ENDPOINT=
# optional - default 0.1
MODEL_TEMPERATURE=
# optional - Unity Catalog volume path for project files
VOLUME_BASE=
# optional - true to run code in a sandbox backend
USE_SANDBOX=
# tools/analytics.py - Genie space ID
GENIE_SPACE_CUSTOMER_ANALYTICS=
# tools/analytics.py - Genie space ID
GENIE_SPACE_DISTRIBUTION_CHANNELS=
# tools/analytics.py - Genie space ID
GENIE_SPACE_POLICY_UNDERWRITING=
# tools/analytics.py - Genie space ID
GENIE_SPACE_CLAIMS_ANALYTICS=
