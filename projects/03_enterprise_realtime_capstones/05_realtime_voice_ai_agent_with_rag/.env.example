# Realtime Voice AI Agent with RAG - copy to .env (never commit .env). Names only; fill in the values you use.
# backend/app/config.py - MongoDB connection string (required)
MONGO_URL=
# backend/app/config.py - optional, default live_db
DB_NAME=
# backend/app/bot.py - speech-to-text
DEEPGRAM_API_KEY=
# backend/app/bot.py - LLM
GROQ_API_KEY=
# backend/app/bot.py - text-to-speech
ELEVENLABS_API_KEY=
# optional - voice to use
ELEVENLABS_VOICE_ID=
# backend/app/services/embeddings.py - document embeddings
GOOGLE_API_KEY=
# backend/main.py - optional CORS origins
ALLOWED_ORIGINS=
# backend/main.py - set to production in the deployed stack
ENVIRONMENT=
