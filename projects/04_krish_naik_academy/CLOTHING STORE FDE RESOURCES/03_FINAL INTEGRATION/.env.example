# Copy this file to `.env` and fill in the values.
# Optional keys are commented out: uncomment one only when you have a real value,
# because a non-empty placeholder counts as set (e.g. it would turn on Portkey routing).

# --- Database (required) ---
MONGO_URI="YOUR_MONGO_URI"

# --- LLM provider (required unless every call goes through Portkey) ---
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# --- Portkey LLM gateway (optional — falls back to calling Groq directly) ---
# PORTKEY_API_KEY="YOUR_PORTKEY_API_KEY"
# PORTKEY_GROQ_PROVIDER="groq"            # provider slug from Portkey's Model Catalog; "@slug" also works

# --- Observability (optional — tracing is a silent no-op without it) ---
# A Logfire *write* token. LOGFIRE_API_KEY is also accepted as an alias.
# LOGFIRE_TOKEN="YOUR_LOGFIRE_WRITE_TOKEN"

# --- Live evals (optional — scores every real chat in the background; needs LOGFIRE_TOKEN) ---
# ONLINE_EVALS_ENABLED=true

# --- Google Sign-In (optional — from Google Cloud Console) ---
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
